# Public Razorpay Key ID only. Never place the Key Secret in browser variables.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me

# Preview-only administrator gate. Replace with Supabase Auth before launch.
VITE_ADMIN_EMAIL=admin@ashoksweets.com
VITE_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# Public Supabase browser configuration. Protect tables with RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credentials, if a Vercel API route needs privileged access.
# Never prefix this value with VITE_ and never commit a real value.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# The server must implement POST /api/razorpay/order using protected credentials,
# verify the payment signature and process Razorpay webhooks.
