# Shiprocket Checkout (server-only — no VITE_ prefix).
# The secret signs every request; anything prefixed VITE_ is compiled into the
# browser bundle and becomes public, so it must never hold the secret.
SHIPROCKET_CHECKOUT_API_KEY=replace_with_checkout_api_key
SHIPROCKET_CHECKOUT_API_SECRET=replace_with_checkout_api_secret
# Optional. Defaults to production; staging is https://fastrr-api-dev.pickrr.com
# SHIPROCKET_CHECKOUT_BASE_URL=https://checkout-api.shiprocket.com

# Preview-only administrator gate. Replace with Supabase Auth before launch.
VITE_ADMIN_EMAIL=admin@ashoksweets.com
VITE_ADMIN_PASSWORD=replace_with_a_strong_temporary_password

# Public Supabase browser configuration. Protect tables with RLS policies.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Shiprocket shipping API (server-only, separate from Checkout above)
# Get these from https://app.shiprocket.in/apiv2
SHIPROCKET_EMAIL=your@email.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Catalog API that Shiprocket syncs products from.
VITE_CLIENT_API_BASE_URL=https://your-client-api.example.com/api/v1
VITE_CLIENT_API_KEY=replace_with_client_api_key
